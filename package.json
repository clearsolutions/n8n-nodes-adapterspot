{
    "name": "n8n-nodes-adapterspot",
    "version": "0.1.0",
    "description": "n8n node for the AdapterSpot Power Supply Identifier API: read a power adapter label from a photo and find the power supply that fits.",
    "license": "MIT",
    "homepage": "https://adapterspot.com/en/api/",
    "keywords": [
        "n8n-community-node-package",
        "adapterspot",
        "power supply",
        "power adapter",
        "label reader",
        "ocr"
    ],
    "author": {
        "name": "Clear Solutions BV (AdapterSpot)",
        "email": "info@adapterspot.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/clearsolutions/n8n-nodes-adapterspot.git"
    },
    "publishConfig": {
        "access": "public"
    },
   "scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
    "files": [
        "dist",
        "!dist/tsconfig.tsbuildinfo"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "strict": true,
        "credentials": [
            "dist/credentials/AdapterSpotApi.credentials.js"
        ],
        "nodes": [
            "dist/nodes/AdapterSpot/AdapterSpot.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "*",
        "eslint": "9.32.0",
        "prettier": "3.6.2",
        "release-it": "^21.1.0",
        "typescript": "5.9.2"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    }
}
